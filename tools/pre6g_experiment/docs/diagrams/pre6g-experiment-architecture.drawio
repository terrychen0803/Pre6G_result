  <diagram id="pre6g-architecture" name="Pre6G Experiment Architecture">
    <mxGraphModel dx="1340" dy="663" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16324F;strokeColor=#16324F;fontColor=#FFFFFF;fontSize=24;align=center;verticalAlign=middle;" value="&lt;b&gt;Pre6G k3s 能耗感知部署實驗平台&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;固定 120 秒 target-process profiling → 離線週期偵測 → Runtime / Energy 預測 → 最省電節點正式部署&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1800" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="lane-control" parent="1" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#EAF2F8;swimlaneFillColor=#F8FBFD;strokeColor=#5B9BD5;fontColor=#1F4E78;fontSize=16;fontStyle=1;" value="&lt;b&gt;A. k3s Control Plane&lt;/b&gt;" vertex="1">
          <mxGeometry height="870" width="430" x="30" y="110" as="geometry" />
        </mxCell>
        <mxCell id="lane-worker" parent="1" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#FFF2CC;swimlaneFillColor=#FFFDF5;strokeColor=#D6B656;fontColor=#7F6000;fontSize=16;fontStyle=1;" value="&lt;b&gt;B. Candidate GPU Workers（每個節點平行）&lt;/b&gt;" vertex="1">
          <mxGeometry height="870" width="520" x="480" y="110" as="geometry" />
        </mxCell>
        <mxCell id="lane-analysis" parent="1" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#E4DFEC;swimlaneFillColor=#FAF8FC;strokeColor=#8064A2;fontColor=#4F3C68;fontSize=16;fontStyle=1;" value="&lt;b&gt;C. Artifacts、Feature 與 Models&lt;/b&gt;" vertex="1">
          <mxGeometry height="870" width="470" x="1020" y="110" as="geometry" />
        </mxCell>
        <mxCell id="netdata-features" parent="lane-analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=13;" value="&lt;b&gt;10B. Netdata Feature Pipeline&lt;/b&gt;&lt;br&gt;依 profiling timestamps 查詢&lt;br&gt;整理固定 18 features&lt;br&gt;schema / unit / missing / gap checks&lt;br&gt;產生 timestamped feature vectors" vertex="1">
          <mxGeometry height="262.5" width="175" x="60" y="210" as="geometry" />
        </mxCell>
        <mxCell id="energy-model" parent="lane-analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA84F;strokeWidth=2;fontSize=13;" value="&lt;b&gt;11B. Energy Model&lt;/b&gt;&lt;br&gt;18 features + time&lt;br&gt;→ P(t)&lt;br&gt;→ trapezoid integration&lt;br&gt;→ total energy" vertex="1">
          <mxGeometry height="125" width="175" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="lane-analysis" source="netdata-features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6AA84F;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" target="energy-model" value="features + time">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SUbuOFqoq07Y4PhfEXk4-3" edge="1" parent="lane-analysis" source="trace-extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="netdata-features" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="trace-extract" parent="lane-analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;strokeWidth=2;fontSize=13;" value="&lt;b&gt;10A. Target-process Trace Pipeline&lt;/b&gt;&lt;br&gt;定位 globalPid / contextId&lt;br&gt;確認 CUDA hardware trace&lt;br&gt;第一個 target kernel 為 prefix 起點&lt;br&gt;7/9/12/15/20/30 秒離線 detector&lt;br&gt;30 秒區段檢查 period/load drift" vertex="1">
          <mxGeometry height="262.5" width="175" x="265" y="210" as="geometry" />
        </mxCell>
        <mxCell id="SUbuOFqoq07Y4PhfEXk4-2" edge="1" parent="lane-analysis" source="trace-extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="netdata-features" value="">
          <mxGeometry relative="1" as="geometry" />
