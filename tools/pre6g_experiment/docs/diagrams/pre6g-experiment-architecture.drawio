        <mxCell id="lane-production" parent="1" style="swimlane;horizontal=0;startSize=34;rounded=1;html=1;fillColor=#E2F0D9;swimlaneFillColor=#F8FCF5;strokeColor=#70AD47;fontColor=#375623;fontSize=16;fontStyle=1;" value="&lt;b&gt;D. Decision 與 Production&lt;/b&gt;" vertex="1">
          <mxGeometry height="870" width="350" x="1510" y="110" as="geometry" />
        </mxCell>
        <mxCell id="user-job" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;strokeWidth=2;fontSize=14;" value="&lt;b&gt;1. 使用者提交 Job YAML&lt;/b&gt;&lt;br&gt;image / command / args&lt;br&gt;CPU、Memory、shared GPU&lt;br&gt;dataset / volumes" vertex="1">
          <mxGeometry height="105" width="330" x="75" y="165" as="geometry" />
        </mxCell>
        <mxCell id="inspect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=2;fontSize=14;" value="&lt;b&gt;2. Validate / Inspect&lt;/b&gt;&lt;br&gt;驗證 batch/v1 Job&lt;br&gt;找 application container&lt;br&gt;從 YAML 推算 total iterations&lt;br&gt;不足時標記 unknown" vertex="1">
          <mxGeometry height="115" width="330" x="75" y="310" as="geometry" />
        </mxCell>
        <mxCell id="discover" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=2;fontSize=14;" value="&lt;b&gt;3. Discover Candidate Nodes&lt;/b&gt;&lt;br&gt;Node Ready / taints&lt;br&gt;GPU sharing resource / UUID&lt;br&gt;replicas、allocation、co-tenants&lt;br&gt;Netdata child readiness" vertex="1">
          <mxGeometry height="125" width="330" x="75" y="465" as="geometry" />
        </mxCell>
        <mxCell id="builder" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=2;fontSize=14;" value="&lt;b&gt;4. Profile Job Builder&lt;/b&gt;&lt;br&gt;從原始 Job deep-copy&lt;br&gt;每個 node 建立獨立 Job&lt;br&gt;加入 nodeSelector / wrapper&lt;br&gt;不覆寫原始 Job" vertex="1">
          <mxGeometry height="125" width="330" x="75" y="630" as="geometry" />
        </mxCell>
        <mxCell id="server-dryrun" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=2;fontSize=14;" value="&lt;b&gt;5. Kubernetes 驗證與建立&lt;/b&gt;&lt;br&gt;kubectl apply --dry-run=server&lt;br&gt;通過後建立所有 Profile Jobs&lt;br&gt;候選節點可平行執行" vertex="1">
          <mxGeometry height="110" width="330" x="75" y="795" as="geometry" />
        </mxCell>
        <mxCell id="profile-job" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;" value="&lt;b&gt;6. Pinned Profile Job / Node&lt;/b&gt;&lt;br&gt;nodeSelector = candidate node&lt;br&gt;nvidia.com/gpu.shared: 1&lt;br&gt;backoffLimit: 0&lt;br&gt;activeDeadlineSeconds: 300" vertex="1">
          <mxGeometry height="115" width="420" x="542" y="165" as="geometry" />
        </mxCell>
        <mxCell id="profile-pod" parent="1" style="swimlane;horizontal=1;startSize=30;rounded=1;html=1;fillColor=#FCE4D6;swimlaneFillColor=#FFFBF8;strokeColor=#ED7D31;fontColor=#843C0C;fontSize=15;fontStyle=1;" value="&lt;b&gt;7. Profile Pod&lt;/b&gt;" vertex="1">
          <mxGeometry height="370" width="440" x="532" y="320" as="geometry" />
        </mxCell>
        <mxCell id="profiler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Profiler / Application Container&lt;/b&gt;&lt;br&gt;nsys profile --trace=cuda,nvtx&lt;br&gt;--sample=none --cpuctxsw=none&lt;br&gt;-- original-command [args]&lt;br&gt;&lt;br&gt;&lt;b&gt;固定 profiling 120 秒&lt;/b&gt;&lt;br&gt;提前完成則保存實際長度" vertex="1">
          <mxGeometry height="210" width="185" x="557" y="370" as="geometry" />
        </mxCell>
        <mxCell id="collector" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Collector Sidecar&lt;/b&gt;&lt;br&gt;等待 capture.complete&lt;br&gt;驗證 report integrity&lt;br&gt;nsys export → SQLite&lt;br&gt;抽取 features / timestamps&lt;br&gt;上傳 artifacts" vertex="1">
          <mxGeometry height="210" width="185" x="772" y="370" as="geometry" />
        </mxCell>
        <mxCell id="artifact-volume" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="&lt;b&gt;Shared artifact volume&lt;/b&gt;&lt;br&gt;.nsys-rep / SQLite / logs&lt;br&gt;completion marker" vertex="1">
          <mxGeometry height="70" width="210" x="647" y="600" as="geometry" />
        </mxCell>
        <mxCell id="netdata" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=14;" value="&lt;b&gt;8. Netdata Child（既有 DaemonSet）&lt;/b&gt;&lt;br&gt;持續監控 node / CPU / GPU / process&lt;br&gt;不隨 Profile Job 啟停&lt;br&gt;依 absolute timestamps 查歷史資料" vertex="1">
          <mxGeometry height="115" width="420" x="542" y="735" as="geometry" />
        </mxCell>
        <mxCell id="parallel-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="worker-4090 / worker-5090 / ...&lt;br&gt;每個候選節點重複步驟 6～8" vertex="1">
          <mxGeometry height="65" width="260" x="622" y="875" as="geometry" />
        </mxCell>
