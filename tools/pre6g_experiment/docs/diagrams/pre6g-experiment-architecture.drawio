          <mxGeometry height="105" width="370" x="1070" y="155" as="geometry" />
        </mxCell>
        <mxCell id="quality-gate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;strokeWidth=2;fontSize=13;" value="&lt;b&gt;12. Quality / OOD Gate&lt;/b&gt;&lt;br&gt;target process、hardware trace&lt;br&gt;≥3 cycles、confidence、drift&lt;br&gt;Netdata samples / gaps / missing&lt;br&gt;失敗節點保留 artifact，但不排名" vertex="1">
